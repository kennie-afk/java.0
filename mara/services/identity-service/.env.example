# Mara identity-service.
#
# None of these have fallback defaults. The service refuses to start without them,
# because a defaulted credential that silently works in production is worse than a
# service that visibly does not.

MARA_DB_URL=jdbc:postgresql://localhost:5432/mara_identity

# Owns the schema, runs migrations. Must NOT be used by the application.
MARA_DB_OWNER_USER=mara_owner
MARA_DB_OWNER_PASSWORD=

# Serves requests. Must be a role that cannot bypass row-level security —
# i.e. not the table owner, and not a superuser. Getting this wrong makes every
# policy in V2__row_level_security.sql decorative.
MARA_DB_APP_USER=mara_app
MARA_DB_APP_PASSWORD=
