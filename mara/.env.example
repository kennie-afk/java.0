# Mara: copy to .env. NONE of the secrets has a default; compose refuses to start without them.
#
# DEVELOPMENT / DEMO ONLY values. Generate different ones for anything that is not a laptop:
#   openssl rand -hex 24

# Owns the schema and runs migrations. Never used to serve requests.
MARA_DB_OWNER_PASSWORD=
# The role requests run as. It cannot bypass row-level security. Set on every startup.
MARA_DB_APP_PASSWORD=
# Credentials (mint with: python3 scripts/new-credential.py --env). One per service, never shared.
# Identity-service stores only hashes; each secret lives in the environment of the one place that needs it.
MARA_SVC_SYNC_CREDENTIAL=
MARA_SVC_CORE_CREDENTIAL=
# Optional rotation overlap: put the OLD service credential here while you roll the new one, then remove it.
MARA_SVC_SYNC_CREDENTIAL_PREVIOUS=
MARA_SVC_CORE_CREDENTIAL_PREVIOUS=
# Optional, lasts 24 h from identity's start, can ONLY manage credentials: use it to mint the first
# platform operator (scripts/demo_seed.py does), then remove it and restart: it is then revoked.
MARA_BOOTSTRAP_CREDENTIAL=


# Fiscal numbers handed to a terminal per lease (5000 in production; small values make the
# renew-at-20% and hand-back behaviour visible in a demo).
MARA_FISCAL_LEASE_SIZE=5000

# Host ports (change when another stack already holds them)
MARA_POSTGRES_PORT=5433
MARA_IDENTITY_PORT=8081
MARA_SYNC_PORT=8082
MARA_CORE_PORT=8083
MARA_TERMINAL_PORT=3100

# Only "mock" exists: the M-Pesa prompt on the till is simulated and moves no money.
MARA_MPESA_MODE=mock

# Per-source-address request caps, per minute, per service replica (defaults shown). Keyed on the
# socket address, never X-Forwarded-For. Every till behind one shop's NAT shares an address, so
# raise MARA_RATELIMIT_TERMINAL_PER_MINUTE for a shop with many terminals.
# MARA_RATELIMIT_ENROLMENT_PER_MINUTE=20
# MARA_RATELIMIT_SIGNIN_PER_MINUTE=120
# MARA_RATELIMIT_TERMINAL_PER_MINUTE=1200
