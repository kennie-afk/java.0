# Mara: copy to .env. NONE of the secrets has a default; compose refuses to start without them.
#
# DEVELOPMENT / DEMO ONLY values. Generate different ones for anything that is not a laptop:
#   openssl rand -hex 24

# Owns the schema and runs migrations. Never used to serve requests.
MARA_DB_OWNER_PASSWORD=
# The role requests run as. It cannot bypass row-level security. Set on every startup.
MARA_DB_APP_PASSWORD=
# Guards /v1/admin/* (create tenants, staff, enrolment codes). 24+ characters.
MARA_ADMIN_TOKEN=

# What sync-service and core-service present to identity-service's /v1/internal/** (and what
# core-service presents to sync-service). Not the admin token. 24+ characters.
MARA_INTERNAL_TOKEN=

# Fiscal numbers handed to a terminal per lease (5000 in production; small values make the
# renew-at-20% and hand-back behaviour visible in a demo).
MARA_FISCAL_LEASE_SIZE=5000

# Host ports (change when another stack already holds them)
MARA_POSTGRES_PORT=5433
MARA_IDENTITY_PORT=8081
MARA_SYNC_PORT=8082
MARA_CORE_PORT=8083
MARA_TERMINAL_PORT=3100

# Only "mock" exists: the M-Pesa prompt on the till is simulated and moves no money.
MARA_MPESA_MODE=mock
