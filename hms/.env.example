# Copy to .env and replace every value. Generate secrets with: openssl rand -base64 36
HMS_DB_OWNER_PASSWORD=change-me
HMS_DB_APP_PASSWORD=change-me-too
HMS_JWT_SECRET=change-me-to-at-least-32-random-characters
# Optional
# HMS_API_PORT=8100
# HMS_CONSOLE_PORT=3600
# HMS_MPESA_MODE=mock
# E-mail and SMS: mock logs a masked line and sends nothing. live is NOT implemented and fails loudly.
# HMS_NOTIFICATIONS_MODE=mock
# HMS_COOKIE_SECURE=true
