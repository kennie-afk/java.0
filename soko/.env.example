POSTGRES_USER=soko
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soko
POSTGRES_PORT=5432

SOKO_JWT_SECRET=generate-a-random-value-of-at-least-32-characters
SOKO_JWT_TTL_MINUTES=720

API_PORT=8090
CONSOLE_PORT=3500
DB_POOL_MAX=24

# Which tenant's catalogue the public /welcome page shows. Leave unset until
# you've seeded a tenant; tools/seed_kamboucha.py prints the slug to fill in
# here once it's run.
STOREFRONT_TENANT_SLUG=

# Demo only. 0 = the mock M-Pesa customer never answers (callbacks are posted by hand, as in
# tools/monetization_check.py); 4 = it approves each STK prompt itself after 4 seconds.
SOKO_MPESA_MOCK_AUTOCOMPLETE_SECONDS=0

# M-Pesa. Leave mode=mock for demos (it accepts any callback, so never expose a mock deployment
# to real customers). For live, set all of these; the callback secret (16+ characters) is added
# to the callback URL registered with Safaricom, and the service will not start without it.
SOKO_MPESA_MODE=mock
# SOKO_MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# SOKO_MPESA_CONSUMER_KEY=
# SOKO_MPESA_CONSUMER_SECRET=
# SOKO_MPESA_SHORT_CODE=
# SOKO_MPESA_PASSKEY=
# SOKO_MPESA_CALLBACK_SECRET=
# SOKO_MPESA_CALLBACK_URL=https://your-host/v1/public/mpesa/stk-callback
